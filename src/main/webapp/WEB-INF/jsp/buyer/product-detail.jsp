<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jsp/includes/header.jspf" %><nav class="breadcrumbs"><a href="${pageContext.request.contextPath}/catalog">Shop</a><span>/</span><c:out value="${product.category}" /></nav><section class="detail-layout"><div class="detail-photo"><img src="<c:out value='${product.imageUrl}' />" alt="<c:out value='${product.name}' />"></div><div class="detail-copy"><span class="eyebrow"><c:out value="${product.category}" /> · Independent maker</span><h1><c:out value="${product.name}" /></h1><div class="detail-rating"><span>★ <fmt:formatNumber value="${averageRating}" maxFractionDigits="1" /></span><span><c:out value="${reviews.size()}" /> reviews</span></div><strong class="detail-price">₹<fmt:formatNumber value="${product.price}" minFractionDigits="2" /></strong><p class="detail-description"><c:out value="${product.description}" /></p><p class="seller-line">Made by <strong><c:out value="${product.sellerName}" /></strong></p><c:choose><c:when test="${product.stockQty > 0}"><div class="stock-note"><span class="stock-dot"></span><c:out value="${product.stockQty}" /> available</div><c:if test="${currentUser.role == 'BUYER'}"><div class="purchase-row"><label class="quantity-control">Qty <input type="number" min="1" max="${product.stockQty}" value="1" data-quantity></label><button class="button" data-add-product="${product.id}" data-use-quantity="true" type="button">Add to bag <span>+</span></button></div></c:if></c:when><c:otherwise><div class="stock-note sold-out">Currently sold out</div></c:otherwise></c:choose><div class="maker-note"><span>✳</span><p>Every purchase supports an independent maker and the care behind their craft.</p></div></div></section><section class="reviews-section" id="reviews"><div class="section-heading"><div><span class="eyebrow">The community says</span><h2>Notes from buyers.</h2></div><div class="review-score">★ <fmt:formatNumber value="${averageRating}" maxFractionDigits="1" /></div></div><div class="review-layout"><div class="review-list"><c:forEach var="review" items="${reviews}"><article class="review-card"><div class="review-card-top"><strong><c:out value="${review.userName}" /></strong><span class="stars"><c:forEach begin="1" end="${review.rating}">★</c:forEach></span></div><p><c:out value="${review.comment}" /></p></article></c:forEach><c:if test="${empty reviews}"><p class="muted">No reviews yet. The first note is always special.</p></c:if></div><c:if test="${currentUser.role == 'BUYER'}"><form class="review-form" method="post" action="${pageContext.request.contextPath}/reviews/create"><span class="eyebrow">Bought and loved it?</span><h3>Leave a note.</h3><input type="hidden" name="productId" value="${product.id}"><label>Your rating<select name="rating" required><option value="5">★★★★★ · Loved it</option><option value="4">★★★★ · Really nice</option><option value="3">★★★ · Good</option><option value="2">★★ · Fair</option><option value="1">★ · Needs work</option></select></label><label>Your note<textarea name="comment" rows="4" maxlength="2000" placeholder="What should other shoppers know?"></textarea></label><button class="button button-dark" type="submit">Share your review</button><small>Reviews are verified against delivered orders.</small></form></c:if></div></section><%@ include file="/WEB-INF/jsp/includes/footer.jspf" %>