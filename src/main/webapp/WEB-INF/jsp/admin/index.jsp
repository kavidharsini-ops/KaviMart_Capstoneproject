<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="../includes/header.jspf" %><section class="page-intro"><span class="eyebrow">The caretaker view</span><h1>Marketplace overview.</h1><p>Keep the community safe and the listings in good shape.</p></section><nav class="admin-tabs"><a href="#members">Members <span><c:out value="${users.size()}" /></span></a><a href="#orders">Orders <span><c:out value="${orders.size()}" /></span></a><a href="#listings">Listings <span><c:out value="${products.size()}" /></span></a></nav><section class="admin-section" id="members"><div class="section-heading"><div><span class="eyebrow">Community</span><h2>Member accounts</h2></div></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th><th>Access</th><th></th></tr></thead><tbody><c:forEach var="member" items="${users}"><tr><td><strong><c:out value="${member.name}" /></strong></td><td><c:out value="${member.email}" /></td><td><span class="role-pill"><c:out value="${member.role}" /></span></td><td>—</td><td><span class="status-pill status-<c:out value='${member.active ? "confirmed" : "cancelled"}' />"><c:out value="${member.active ? 'Active' : 'Banned'}" /></span></td><td><c:if test="${member.role != 'ADMIN'}"><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="userId" value="${member.id}"><button class="text-button" name="action" value="${member.active ? 'ban' : 'activate'}" type="submit"><c:out value="${member.active ? 'Ban' : 'Activate'}" /></button></form></c:if></td></tr></c:forEach></tbody></table></div></section><section class="admin-section" id="orders"><div class="section-heading"><div><span class="eyebrow">Fulfillment</span><h2>All orders</h2></div></div><div class="orders-list"><c:forEach var="order" items="${orders}"><article class="order-card"><div class="order-head"><div><span class="eyebrow">Order #<c:out value="${order.id}" /></span><h2><c:out value="${order.buyerName}" /></h2></div><span class="status-pill status-<c:out value='${order.status.toLowerCase()}' />"><c:out value="${order.status}" /></span></div><div class="order-items"><c:forEach var="line" items="${order.items}"><span><c:out value="${line.productName}" /> × <c:out value="${line.quantity}" /></span></c:forEach></div><div class="order-total"><span>Total</span><strong>$<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2" /></strong></div></article></c:forEach></div><c:if test="${empty orders}"><p class="muted">There are no orders yet.</p></c:if></section><section class="admin-section" id="listings"><div class="section-heading"><div><span class="eyebrow">Marketplace quality</span><h2>Product listings</h2></div></div><div class="seller-product-list"><c:forEach var="product" items="${products}"><article class="seller-product"><img src="<c:out value='${product.imageUrl}' />" alt="<c:out value='${product.name}' />"><div><span class="eyebrow"><c:out value="${product.category}" /> · <c:out value="${product.sellerName}" /></span><h3><c:out value="${product.name}" /></h3><span class="muted">$<fmt:formatNumber value="${product.price}" minFractionDigits="2" /></span></div><form method="post" action="${pageContext.request.contextPath}/admin" onsubmit="return confirm('Remove this listing?');"><input type="hidden" name="productId" value="${product.id}"><button class="remove-link" name="action" value="remove-listing" type="submit">Remove listing</button></form></article></c:forEach></div><c:if test="${empty products}"><p class="muted">There are no active listings.</p></c:if></section><%@ include file="../includes/footer.jspf" %>