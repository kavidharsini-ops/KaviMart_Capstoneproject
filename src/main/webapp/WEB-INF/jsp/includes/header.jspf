<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="currentUser" value="${sessionScope['kavimart.user']}" />
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${pageTitle}" default="KaviMart · Good finds, good people" /></title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/styles.css"></head><body data-base="${pageContext.request.contextPath}"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/catalog"><span class="brand-mark">K</span><span>Kavi<span class="brand-accent">Mart</span><small>good finds, good people</small></span></a><nav class="main-nav"><a href="${pageContext.request.contextPath}/catalog">Shop</a><c:choose><c:when test="${currentUser.role == 'SELLER'}"><a href="${pageContext.request.contextPath}/seller/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/seller/products">My listings</a><a href="${pageContext.request.contextPath}/seller/orders">Orders</a></c:when><c:when test="${currentUser.role == 'ADMIN'}"><a href="${pageContext.request.contextPath}/admin">Admin</a></c:when><c:when test="${currentUser.role == 'BUYER'}"><a href="${pageContext.request.contextPath}/buyer/orders">My orders</a><a href="${pageContext.request.contextPath}/buyer/cart">Bag</a></c:when></c:choose></nav><div class="nav-actions"><c:choose><c:when test="${not empty currentUser}"><span class="nav-name">Hi, <c:out value="${currentUser.name}" /></span><form class="inline-form" method="post" action="${pageContext.request.contextPath}/auth/logout"><button class="button button-quiet button-small" type="submit">Sign out</button></form></c:when><c:otherwise><a class="nav-login" href="${pageContext.request.contextPath}/auth/login">Sign in</a><a class="button button-small" href="${pageContext.request.contextPath}/auth/register">Join us</a></c:otherwise></c:choose></div></header><main class="page-shell">