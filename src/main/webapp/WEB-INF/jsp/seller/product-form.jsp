<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jsp/includes/header.jspf" %><section class="form-page"><a class="back-link" href="${pageContext.request.contextPath}/seller/products">← Back to my listings</a><form class="form-card listing-form" method="post" action="${pageContext.request.contextPath}/seller/products"><span class="eyebrow">The details</span><h1><c:choose><c:when test="${empty product}">Add a listing</c:when><c:otherwise>Edit your listing</c:otherwise></c:choose></h1><c:if test="${not empty product}"><input type="hidden" name="id" value="${product.id}"></c:if><label>Product name<input name="name" required maxlength="200" value="<c:out value='${product.name}' />"></label><label>Description<textarea name="description" rows="5" maxlength="5000"><c:out value="${product.description}" /></textarea></label><div class="form-grid"><label>Price (USD)<input type="number" name="price" min="0" step="0.01" required value="<c:out value='${product.price}' />"></label><label>Available quantity<input type="number" name="stock" min="0" step="1" required value="<c:out value='${product.stockQty}' default='0' />"></label></div><label>Category<select name="category" required><c:forEach var="cat" items="${categories}"><option value="<c:out value='${cat}' />" <c:if test="${product.category == cat}">selected</c:if>><c:out value="${cat}" /></option></c:forEach></select></label><label>Image URL<input type="url" name="imageUrl" maxlength="500" placeholder="https://…" value="<c:out value='${product.imageUrl}' />"><small>Use a public image URL; leave blank if you don't have one.</small></label><button class="button button-full" type="submit">Save listing <span>→</span></button></form></section><%@ include file="/WEB-INF/jsp/includes/footer.jspf" %>