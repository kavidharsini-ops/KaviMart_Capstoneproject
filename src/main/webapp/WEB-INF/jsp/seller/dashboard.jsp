<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jsp/includes/header.jspf" %><section class="page-intro"><span class="eyebrow">Your shop, at a glance</span><h1>Good morning, <c:out value="${currentUser.name}" />.</h1><p>Here’s how your work is finding its way into the world.</p></section><div class="metric-grid"><article class="metric-card"><span class="eyebrow">Orders</span><strong><fmt:formatNumber value="${stats.orders}" maxFractionDigits="0" /></strong><span>orders containing your listings</span></article><article class="metric-card metric-accent"><span class="eyebrow">Revenue</span><strong>₹<fmt:formatNumber value="${stats.revenue}" minFractionDigits="2" /></strong><span>across non-cancelled orders</span></article><article class="metric-card"><span class="eyebrow">Your collection</span><strong><c:out value="${orders.size()}" /></strong><span>incoming orders to review</span></article></div><section class="dashboard-section"><div class="section-heading"><div><span class="eyebrow">Recent activity</span><h2>Orders to keep moving.</h2></div><a class="text-link" href="${pageContext.request.contextPath}/seller/orders">See all orders →</a></div><c:choose><c:when test="${empty orders}"><div class="empty-state compact"><p>When buyers order your products, their order status will appear here.</p><a href="${pageContext.request.contextPath}/seller/products">Manage your listings →</a></div></c:when><c:otherwise><div class="orders-list"><c:forEach var="order" items="${orders}" begin="0" end="2"><article class="order-card"><div class="order-head"><div><span class="eyebrow">Order #<c:out value="${order.id}" /></span><h2><c:out value="${order.buyerName}" /></h2></div><span class="status-pill status-<c:out value='${order.status.toLowerCase()}' />"><c:out value="${order.status}" /></span></div><div class="order-items"><c:forEach var="line" items="${order.items}"><span><c:out value="${line.productName}" /> · <c:out value="${line.quantity}" /> × ₹<fmt:formatNumber value="${line.unitPrice}" minFractionDigits="2" /></span></c:forEach></div></article></c:forEach></div></c:otherwise></c:choose></section><%@ include file="/WEB-INF/jsp/includes/footer.jspf" %>