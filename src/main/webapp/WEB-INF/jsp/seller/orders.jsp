<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jsp/includes/header.jspf" %><section class="page-intro"><span class="eyebrow">Orders that include your work</span><h1>Incoming orders.</h1><p>Keep buyers in the loop as their order makes its way to them.</p></section><c:choose><c:when test="${empty orders}"><div class="empty-state"><h2>It's quiet for now.</h2><p>New orders will show here when a customer finds something they love.</p></div></c:when><c:otherwise><div class="orders-list"><c:forEach var="order" items="${orders}"><article class="order-card"><div class="order-head"><div><span class="eyebrow">Order #<c:out value="${order.id}" /></span><h2><c:out value="${order.buyerName}" /></h2><span class="muted"><c:out value="${order.createdAt}" /></span></div><span class="status-pill status-<c:out value='${order.status.toLowerCase()}' />"><c:out value="${order.status}" /></span></div><div class="order-items"><c:forEach var="line" items="${order.items}"><div class="order-item"><span><c:out value="${line.productName}" /> <small>× <c:out value="${line.quantity}" /></small></span><span>$<fmt:formatNumber value="${line.unitPrice * line.quantity}" minFractionDigits="2" /></span></div></c:forEach></div><c:choose><c:when test="${order.status == 'PENDING'}"><c:set var="nextStatus" value="CONFIRMED" /></c:when><c:when test="${order.status == 'CONFIRMED'}"><c:set var="nextStatus" value="SHIPPED" /></c:when><c:when test="${order.status == 'SHIPPED'}"><c:set var="nextStatus" value="DELIVERED" /></c:when><c:otherwise><c:set var="nextStatus" value="" /></c:otherwise></c:choose><c:if test="${not empty nextStatus}"><form class="status-action" method="post" action="${pageContext.request.contextPath}/seller/orders"><input type="hidden" name="orderId" value="${order.id}"><input type="hidden" name="status" value="${nextStatus}"><button class="button button-small" type="submit">Mark <c:out value="${nextStatus.toLowerCase()}" /></button></form></c:if></article></c:forEach></div></c:otherwise></c:choose><%@ include file="/WEB-INF/jsp/includes/footer.jspf" %>