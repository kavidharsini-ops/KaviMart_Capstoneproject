<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jsp/includes/header.jspf" %><section class="page-intro"><span class="eyebrow">Your good finds</span><h1>Your bag.</h1><p>A few thoughtful choices, all in one place.</p></section><c:choose><c:when test="${empty items}"><div class="empty-state"><span class="eyebrow">Nothing in here yet</span><h2>Your next favorite is out there.</h2><p>Take another look around our maker collection.</p><a class="button" href="${pageContext.request.contextPath}/catalog">Explore the shop</a></div></c:when><c:otherwise><div class="cart-layout"><div class="cart-lines"><c:forEach var="item" items="${items}"><article class="cart-line" data-cart-item="${item.product.id}"><img src="<c:out value='${item.product.imageUrl}' />" alt="<c:out value='${item.product.name}' />"><div class="cart-line-info"><a href="${pageContext.request.contextPath}/products/${item.product.id}"><h3><c:out value="${item.product.name}" /></h3></a><span>Made by <c:out value="${item.product.sellerName}" /></span><button type="button" class="remove-link" data-remove-item="${item.product.id}">Remove</button></div><label class="cart-quantity">Qty <input type="number" min="1" max="${item.product.stockQty}" value="${item.quantity}" data-update-quantity="${item.product.id}"></label><strong class="cart-line-price">₹<fmt:formatNumber value="${item.lineTotal}" minFractionDigits="2" /></strong></article></c:forEach></div><aside class="order-summary"><span class="eyebrow">Order summary</span><h2>Almost yours.</h2><div class="summary-row"><span>Subtotal</span><strong data-cart-total>₹<fmt:formatNumber value="${total}" minFractionDigits="2" /></strong></div><div class="summary-row muted"><span>Shipping</span><span>Calculated at dispatch</span></div><p class="summary-note">Your payment is simulated for this demo. No real payment is collected.</p><button class="button button-full" type="button" data-checkout>Continue to checkout <span>→</span></button><a class="summary-back" href="${pageContext.request.contextPath}/catalog">← Keep browsing</a><div class="inline-status" data-cart-message aria-live="polite"></div></aside></div></c:otherwise></c:choose><%@ include file="/WEB-INF/jsp/includes/footer.jspf" %>