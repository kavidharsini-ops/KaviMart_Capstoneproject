<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jsp/includes/header.jspf" %><section class="shop-hero"><div class="hero-copy"><span class="eyebrow">A marketplace for makers & finders</span><h1>Find the things<br>that feel like <em>you.</em></h1><p>Small-batch goods, thoughtful details, and independent makers worth knowing.</p><a class="text-link" href="#shop">Explore the collection <span>↓</span></a></div><div class="hero-image" role="img" aria-label="Thoughtfully made home goods"></div><div class="hero-stamp"><span>MADE<br>WITH<br>INTENTION</span></div></section><section class="shop-section" id="shop"><div class="section-heading"><div><span class="eyebrow">The collection</span><h2>Good things, gathered.</h2></div><p><c:out value="${products.total}" /> considered finds from independent sellers</p></div><form class="search-toolbar" method="get" action="${pageContext.request.contextPath}/catalog"><label class="search-box"><span>⌕</span><input type="search" name="q" placeholder="Search makers, materials, little joys…" value="<c:out value='${param.q}' />" maxlength="100"></label><label class="filter-select"><span>Category</span><select name="category"><option value="">Everything</option><c:forEach var="category" items="${categories}"><option value="<c:out value='${category}' />" <c:if test="${param.category == category}">selected</c:if>><c:out value="${category}" /></option></c:forEach></select></label><label class="filter-select"><span>Sort by</span><select name="sort"><option value="newest">Recently added</option><option value="price_asc" <c:if test="${param.sort == 'price_asc'}">selected</c:if>>Price: low to high</option><option value="price_desc" <c:if test="${param.sort == 'price_desc'}">selected</c:if>>Price: high to low</option></select></label><button class="button button-dark" type="submit">Find something</button></form><div class="product-grid"><c:forEach var="product" items="${products.items}"><article class="product-card"><a class="product-photo" href="${pageContext.request.contextPath}/products/${product.id}"><img src="<c:out value='${product.imageUrl}' />" alt="<c:out value='${product.name}' />" loading="lazy"><span class="product-category"><c:out value="${product.category}" /></span></a><div class="product-info"><div class="product-meta"><a href="${pageContext.request.contextPath}/products/${product.id}"><h3><c:out value="${product.name}" /></h3></a><strong>$<fmt:formatNumber value="${product.price}" minFractionDigits="2" /></strong></div><span class="seller-name">Made by <c:out value="${product.sellerName}" /></span><button class="quick-add" data-add-product="${product.id}" type="button">Add to bag <span>+</span></button></div></article></c:forEach></div><c:if test="${empty products.items}"><div class="empty-state"><span class="eyebrow">No matches just yet</span><h3>Try another search.</h3><p>There are always more good things to discover.</p><a href="${pageContext.request.contextPath}/catalog">Clear filters</a></div></c:if><c:if test="${products.pages > 1}"><nav class="pagination"><c:if test="${products.page > 1}"><a href="?q=<c:out value='${param.q}' />&category=<c:out value='${param.category}' />&sort=<c:out value='${param.sort}' />&page=${products.page-1}">← Newer</a></c:if><span>Page <c:out value="${products.page}" /> of <c:out value="${products.pages}" /></span><c:if test="${products.page < products.pages}"><a href="?q=<c:out value='${param.q}' />&category=<c:out value='${param.category}' />&sort=<c:out value='${param.sort}' />&page=${products.page+1}">Older →</a></c:if></nav></c:if></section><%@ include file="/WEB-INF/jsp/includes/footer.jspf" %>