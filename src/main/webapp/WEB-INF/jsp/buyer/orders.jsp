<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jsp/includes/header.jspf" %><section class="page-intro"><span class="eyebrow">The journey so far</span><h1>Your orders.</h1><p>Every order supports the person behind the product.</p></section><c:if test="${param.placed == '1'}"><div class="notice success">Your order is confirmed. The maker has been notified.</div></c:if><c:choose><c:when test="${empty orders}"><div class="empty-state"><h2>No orders yet.</h2><p>When something catches your eye, you'll find it here.</p><a class="button" href="${pageContext.request.contextPath}/catalog">Browse the collection</a></div></c:when><c:otherwise><div class="orders-list"><c:forEach var="order" items="${orders}"><article class="order-card"><div class="order-head"><div><span class="eyebrow">Order #<c:out value="${order.id}" /></span><h2><c:out value="${order.createdAt}" /></h2></div><span class="status-pill status-<c:out value='${order.status.toLowerCase()}' />"><c:out value="${order.status}" /></span></div><div class="order-items"><c:forEach var="line" items="${order.items}"><div class="order-item"><span><c:out value="${line.productName}" /> <small>× <c:out value="${line.quantity}" /></small></span><span>₹<fmt:formatNumber value="${line.unitPrice * line.quantity}" minFractionDigits="2" /></span></div></c:forEach></div><div class="order-total"><span>Order total</span><strong>₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2" /></strong></div><c:if test="${order.status == 'PENDING'}"><form method="post" action="${pageContext.request.contextPath}/buyer/orders" onsubmit="return confirm('Cancel this pending order?');"><input type="hidden" name="action" value="cancel"><input type="hidden" name="orderId" value="${order.id}"><button class="remove-link" type="submit">Cancel pending order</button></form></c:if></article></c:forEach></div></c:otherwise></c:choose><%@ include file="/WEB-INF/jsp/includes/footer.jspf" %>